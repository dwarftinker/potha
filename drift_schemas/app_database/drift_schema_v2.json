  "fixed_sql": [
    {
      "name": "books",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"books\" (\"id\" TEXT NOT NULL, \"format\" TEXT NOT NULL, \"title\" TEXT NOT NULL, \"author\" TEXT NULL, \"sort_title\" TEXT NOT NULL, \"search_key\" TEXT NOT NULL, \"original_file_name\" TEXT NOT NULL, \"content_hash\" TEXT NOT NULL UNIQUE, \"size_bytes\" INTEGER NOT NULL, \"page_count\" INTEGER NOT NULL CHECK(\"page_count\" > 0), \"is_password_protected\" INTEGER NOT NULL CHECK (\"is_password_protected\" IN (0, 1)), \"added_at\" INTEGER NOT NULL, \"last_opened_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "book_covers",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"book_covers\" (\"book_id\" TEXT NOT NULL REFERENCES books (id) ON DELETE CASCADE, \"image\" BLOB NOT NULL, PRIMARY KEY (\"book_id\"));"
        }
      ]
    },
    {
      "name": "reading_progress",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"reading_progress\" (\"book_id\" TEXT NOT NULL REFERENCES books (id) ON DELETE CASCADE, \"current_page\" INTEGER NOT NULL CHECK(\"current_page\" >= 1), \"updated_at\" INTEGER NOT NULL, \"page_offset\" REAL NOT NULL DEFAULT 0.0 CHECK(\"page_offset\" BETWEEN 0.0 AND 1.0), \"page_mode\" TEXT NULL, PRIMARY KEY (\"book_id\"));"
        }
      ]
    },
    {
      "name": "library_preferences",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"library_preferences\" (\"id\" INTEGER NOT NULL, \"sort_order\" TEXT NOT NULL DEFAULT 'recentlyOpened', \"view_mode\" TEXT NOT NULL DEFAULT 'grid', \"web_storage_notice_shown\" INTEGER NOT NULL DEFAULT 0 CHECK (\"web_storage_notice_shown\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "reader_preferences",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"reader_preferences\" (\"id\" INTEGER NOT NULL, \"theme\" TEXT NOT NULL DEFAULT 'light', \"fit\" TEXT NOT NULL DEFAULT 'fitWidth', PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "books_last_opened_at",
